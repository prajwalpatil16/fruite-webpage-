FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=0
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-to-another-long-random-string

# Traditional MySQL config (shop style — not a DATABASE_URL)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB=fruitbasket_db

# Optional local fallback without MySQL:
# DB_ENGINE=sqlite

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Google Identity Services (Web client ID — same value in frontend VITE_GOOGLE_CLIENT_ID)
# Authorized JavaScript origins must include http://localhost:5173 and http://127.0.0.1:5173
GOOGLE_CLIENT_ID=
